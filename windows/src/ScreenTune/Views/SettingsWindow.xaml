<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenTune.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="ScreenTune Settings">

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- Settings rows: tonal cards without the default stroke. -->
            <Style TargetType="toolkit:SettingsCard">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <!-- Tonal buttons: keep the Fluent fill, drop the elevation stroke. -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="GroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,20,0,4" />
            </Style>
            <Style x:Key="FooterStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: icon and caption, system close button on the right -->
        <Grid x:Name="TitleBar" Height="32" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="ScreenTune Settings" />
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,0,24,24" Spacing="4">

                <TextBlock Margin="0,8,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Profiles" />
                <toolkit:SettingsCard Header="Screen">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <TextBlock x:Name="ScreenName" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Saves or loads this screen's settings as a file. Files work with ScreenTune for Mac too." Header="Profile">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnImportClick" Content="Import…" />
                        <Button Click="OnExportClick" Content="Export…" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <TextBlock x:Name="ProfileMessage" Style="{StaticResource FooterStyle}" Visibility="Collapsed" />
                <TextBlock Style="{StaticResource FooterStyle}" Text="Import and export apply to the screen picked in the ScreenTune flyout." />

                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="General" />
                <toolkit:SettingsCard x:Name="StartupCard" Header="Launch at startup">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.Description>
                        <StackPanel x:Name="StartupBlocked" Visibility="Collapsed">
                            <TextBlock Text="Turned off in Startup apps." TextWrapping="Wrap" />
                            <HyperlinkButton Padding="0" Click="OnOpenStartupAppsClick" Content="Open Startup apps" />
                        </StackPanel>
                    </toolkit:SettingsCard.Description>
                    <ToggleSwitch x:Name="StartupSwitch" AutomationProperties.Name="Launch at startup" Toggled="OnStartupToggled" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    Description="Windows blocks tone curves that move far from normal, such as strong warmth or a big black lift. Unlocking lifts that limit for this PC and needs administrator approval."
                    Header="Full-range curves">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9E9;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <Grid>
                        <Button x:Name="UnlockButton" Click="OnUnlockClick" Content="Unlock…" />
                        <TextBlock
                            x:Name="UnlockedText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Unlocked"
                            Visibility="Collapsed" />
                    </Grid>
                </toolkit:SettingsCard>
                <TextBlock x:Name="UnlockMessage" Style="{StaticResource FooterStyle}" Visibility="Collapsed" />
                <TextBlock Style="{StaticResource FooterStyle}" Text="Settings re-apply automatically after display changes, sleep, lock, and KVM switches." />

                <TextBlock Style="{StaticResource GroupHeaderStyle}" Text="About" />
                <toolkit:SettingsCard Header="Version">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                </toolkit:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
